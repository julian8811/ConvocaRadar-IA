# ============================================================================
# SAFETY: These are placeholders for local development only.
# NEVER commit real secrets. NEVER deploy with these values.
# Required secrets (JWT_SECRET, INTERNAL_API_KEY) must be at least 32 chars.
# The application will refuse to start if they are missing or too short.
# ============================================================================

APP_ENV=development
APP_NAME=ConvocaRadar IA
DATABASE_URL=sqlite:///./convocaradar.db
POSTGRES_DATABASE_URL=postgresql+psycopg://convocaradar:convocaradar@postgres:5432/convocaradar
REDIS_URL=redis://localhost:6379/0
# Must be at least 32 characters
JWT_SECRET=change_me_jwt_secret_32_chars_placeholder_
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
USE_WORKER=false
# Must be at least 32 characters
INTERNAL_API_KEY=change_me_internal_api_key_32_chars_
# Required: separate secret for password-reset tokens (min 32 chars).
RESET_TOKEN_SECRET=change_me_reset_secret_32_chars__
LLM_PROVIDER=cloudflare
LLM_API_BASE=https://api.cloudflare.com/client/v4/accounts/133cf93f64119c34540ecfe996ef671a/ai/v1
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIMENSIONS=1024
CHAT_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
LLM_TIMEOUT_SECONDS=90
BOOTSTRAP_SOURCES_ON_STARTUP=true
BOOTSTRAP_SOURCES_BLOCKING=false
BOOTSTRAP_SOURCE_KEYS=grants-gov-rss,grants-gov,innpulsa,minciencias,nsf-funding-rss
SENTRY_DSN=
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10000000
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-this-minio-password
S3_BUCKET=convocaradar
S3_REGION=us-east-1
SCRAPING_USER_AGENT=Mozilla/5.0 (compatible; ConvocaRadarBot/1.0; +https://github.com/ConvocaRadar/ConvocaRadar-IA)
SCRAPING_TIMEOUT_SECONDS=30
SCRAPING_MAX_SOURCE_SECONDS=90
SCRAPING_MAX_CONCURRENCY=2
SCRAPING_CLOSING_SOON_DAYS=10
SCRAPING_EXECUTION_MODE=inline
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Frontend environment marker (SEC-1.3). Set to "production" in production
# builds to hide the dev-credentials helper. The web build defaults to
# "development" locally; CI sets it to "production".
NEXT_PUBLIC_ENV=development

# Dev-only credentials (SEC-1.3). ONLY used when NEXT_PUBLIC_ENV is not
# "production". In production these must be empty / unset so no dev creds
# leak into the bundle. For local dev, copy the values below to
# apps/web/.env.development (gitignored).
NEXT_PUBLIC_LOCAL_EMAIL=dev@convocaradar.local
NEXT_PUBLIC_LOCAL_PASSWORD=change-me-for-local-dev-only
LLM_API_KEY=your_cloudflare_api_key_here
RESEND_FROM=Observatorio de Convocatorias <onboarding@resend.dev>
ALERT_DEFAULT_RECIPIENT=julianmontoya8811@hotmail.com


# ── Email configuration (Gmail SMTP) ────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Observatorio de Convocatorias <onboarding@resend.dev>
SMTP_HOST=
