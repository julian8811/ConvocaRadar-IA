# Python build artefacts
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info
.eggs
build/
dist/

# Virtual envs
.venv
venv/
env/

# Tests, caches, tooling
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
.coverage.*
htmlcov/
.tox/
.cache

# Local dev artefacts
*.db
*.sqlite
*.sqlite3
test_storage/

# Editor / OS
.idea
.vscode
.DS_Store
*.swp

# Secrets — never copy into the image
.env
.env.*
!.env.example
!.env.production.example

# Git
.git
.gitignore
.gitattributes
.github

# Docker-related (no recursion)
Dockerfile
.dockerignore
docker-compose*.yml

# Docs and changelogs (not needed at runtime)
*.md
!apps/api/app/**/*.md
CHANGELOG*
LICENSE*
