# ============================================================================
# SAFETY: production template — never commit real secrets or deploy placeholders.
# ConvocaRadar IA — production environment template
# ============================================================================
# Copy to .env on the server and replace every placeholder before deploying.
# NEVER commit the real .env file or production secrets.
# Generate secrets on the server, for example:
#   openssl rand -base64 24  # POSTGRES_PASSWORD / MINIO_ROOT_PASSWORD
#   openssl rand -base64 48  # JWT_SECRET / INTERNAL_API_KEY / RESET_TOKEN_SECRET
# ============================================================================

# Public application URLs
APP_ENV=production
APP_NAME=ConvocaRadar IA
FRONTEND_URL=https://convocaradar.example.edu.co
BACKEND_URL=https://convocaradar.example.edu.co

# Next.js values are embedded at image build time. In the server compose the
# browser uses the same origin and Next.js proxies /api/v1 to the private API.
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_ENABLE_WAKE_RETRIES=true
NEXT_PUBLIC_LOCAL_EMAIL=
NEXT_PUBLIC_LOCAL_PASSWORD=

# PostgreSQL
POSTGRES_PASSWORD=replace_with_strong_postgres_password_16plus_chars
DATABASE_URL=postgresql+psycopg://convocaradar:replace_with_strong_postgres_password_16plus_chars@postgres:5432/convocaradar

# Authentication / application secrets
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INTERNAL_API_KEY=replace_with_a_second_long_random_secret_at_least_32_chars
RESET_TOKEN_SECRET=replace_with_strong_reset_secret_at_least_32_chars

# Object storage (the server compose overrides endpoint/access credentials to
# the private MinIO service; these values document the production defaults).
STORAGE_BACKEND=s3
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10000000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace_with_strong_minio_password_16plus_chars
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=replace_with_same_value_as_MINIO_ROOT_PASSWORD
S3_BUCKET=convocaradar
S3_REGION=auto

# Optional Redis / external queue. The built-in scheduler worker does not
# require this when SCRAPING_EXECUTION_MODE=inline.
REDIS_URL=
USE_WORKER=false

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini

# Source bootstrap / scraping
BOOTSTRAP_SOURCES_ON_STARTUP=true
BOOTSTRAP_SOURCES_BLOCKING=false
BOOTSTRAP_SOURCE_KEYS=grants-gov-rss,grants-gov,innpulsa,minciencias,nsf-funding-rss
SCRAPING_USER_AGENT=ConvocaRadarBot/0.1
SCRAPING_TIMEOUT_SECONDS=30
SCRAPING_MAX_SOURCE_SECONDS=90
SCRAPING_MAX_CONCURRENCY=5
SCRAPING_CLOSING_SOON_DAYS=10
SCRAPING_EXECUTION_MODE=inline

# Email — leave provider credentials empty until configured on the server.
# Prefer a dedicated institutional/service account rather than a personal one.
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Observability
SENTRY_DSN=

# Server deployment
WEB_PORT=3001
BACKUP_RETENTION_DAYS=14
